<Window x:Class="LockStepAI.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LockStep Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        Focusable="False"
        WindowStartupLocation="Manual">

    <!-- The canvas spans the whole screen. We draw on this. -->
    <Canvas x:Name="OverlayCanvas" Background="{x:Null}" IsHitTestVisible="False"/>
</Window>