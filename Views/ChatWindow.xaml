<Window x:Class="LockStepAI.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LockStep Chat" Width="380" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Icon="pack://application:,,,/Assets/icon.png"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Border x:Name="MainContainer" Background="#0A0A0A" CornerRadius="16" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#121212" CornerRadius="16,16,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="#FFFFFF" 
                                Background="Transparent" BorderThickness="0" Click="Hamburger_Click" Cursor="Hand" Margin="0,0,10,0"/>
                        <TextBlock Text="LockStep" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="30" Height="30" Background="Transparent" Foreground="#AAAAAA" 
                            BorderThickness="0" FontFamily="Segoe MDL2 Assets" Content="&#xE711;" 
                            Cursor="Hand" Click="Hide_Click" ToolTip="Hide"/>
                </Grid>
            </Border>

            <!-- Chat Area -->
            <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="15">
                <StackPanel x:Name="MessagePanel"/>
            </ScrollViewer>

            <!-- Input Area -->
            <Border Grid.Row="2" Background="#121212" CornerRadius="0,0,16,16" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Background="#0A0A0A" Foreground="#FFFFFF" 
                             BorderThickness="1" BorderBrush="#333333" Padding="10" FontSize="13" 
                             CaretBrush="#FFFFFF" KeyDown="InputBox_KeyDown"/>
                    <Button Grid.Column="1" Content="&#xE724;" FontFamily="Segoe MDL2 Assets"
                            Width="35" Height="35" Margin="8,0,0,0"
                            Background="#FFFFFF" Foreground="#000000" BorderThickness="0"
                            Cursor="Hand" Click="SendButton_Click"/>
                </Grid>
            </Border>

            <!-- History Menu Sidebar -->
            <Border x:Name="HistoryMenu" Grid.Row="1" Grid.RowSpan="3" Background="#0F0F0F" Visibility="Collapsed" CornerRadius="0,0,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="+ New Chat" Click="NewChat_Click" Background="#FFFFFF" Foreground="Black" Margin="10" Padding="10" Cursor="Hand"/>

                    <ListBox x:Name="ChatHistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                             Foreground="#FFFFFF" MouseDoubleClick="ChatHistoryList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="320" Margin="0,5">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" Click="RenameChat_Click" Tag="{Binding Id}" Cursor="Hand" Margin="5,0"/>
                                        <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="#FF4136" BorderThickness="0" Click="DeleteChat_Click" Tag="{Binding Id}" Cursor="Hand" Margin="5,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>