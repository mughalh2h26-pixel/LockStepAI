<Window x:Class="LockStepAI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting LockStep" Height="420" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">

    <Grid>
        <Image Source="pack://application:,,,/Assets/icon.png"
               Width="350" Height="350"
               Stretch="Uniform" VerticalAlignment="Top"/>

        <TextBlock x:Name="StatusText"
                   Text="LockStep starting..."
                   Foreground="White"
                   FontSize="14"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="93,0,0,86">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>