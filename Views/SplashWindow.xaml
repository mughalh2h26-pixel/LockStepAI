<Window x:Class="LockStepAI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting LockStepAI" Height="420" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">

    <Grid>
        <Image Source="pack://application:,,,/Assets/icon.png"
               Width="350" Height="350"
               Stretch="Uniform" VerticalAlignment="Top"/>

        <Button x:Name="CancelButton"
                Content="&#xE711;"
                FontFamily="Segoe MDL2 Assets"
                Foreground="White"
                Background="#66000000"
                BorderThickness="0"
                Width="30" Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,8,0"
                Cursor="Hand"
                Click="CancelStartup_Click"
                ToolTip="Cancel startup"/>

        <TextBlock x:Name="StatusText"
                   Text="LockStepAI starting..."
                   Foreground="White"
                   FontSize="14"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="66,0,0,87">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>